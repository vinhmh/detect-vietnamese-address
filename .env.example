# Copy this file to .env and adjust as needed.
# .env is read by docker-compose and by the Python scripts when running locally.

POSTGRES_HOST=localhost        # use "postgres" when running inside Docker
POSTGRES_PORT=5432
POSTGRES_DB=vn_address
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Full DSN — used by ETL scripts and the API
# Locally:  postgresql://postgres:postgres@localhost:5432/vn_address
# Docker:   postgresql://postgres:postgres@postgres:5432/vn_address
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vn_address

# Port the API listens on (host side)
API_PORT=8000

# Gemini API key — enables Gemini + Google Search grounding for POI address lookup
# (hospitals, universities, hotels…). Falls back to Nominatim if not set.
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_key_here
